# Kopieren nach .env und anpassen
# Zugang der Geraete zum MQTT-Broker (am Geraet unter System -> Cloud / MQTT eintragen)
MQTT_USER=hermit
MQTT_PASS=bitte-aendern
# Passwort fuer die Weboberflaeche (leer = ohne Anmeldung, nur im eigenen Netz sinnvoll)
CLOUD_PASSWORD=bitte-aendern
# IP dieses Rechners – wird in der Oberflaeche als Broker-Adresse angezeigt
PUBLIC_BROKER=192.168.0.50
WEB_PORT=8080
TZ=Europe/Berlin
